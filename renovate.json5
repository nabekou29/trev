{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    // Always use Conventional Commits instead of relying on auto-detection.
    ":semanticCommits",
    // config:recommended would make regular dependency bumps `fix(deps)`, which
    // git-cliff puts in the changelog. Keep them as `chore(deps)` like manual updates.
    ":semanticCommitType(chore)",
    "group:allNonMajor",
    "schedule:monthly",
  ],
  timezone: "Asia/Tokyo",
  // Generated by cargo-dist. Update it by bumping `cargo-dist-version` in
  // dist-workspace.toml and regenerating, not by bumping actions individually.
  ignorePaths: [".github/workflows/release.yml"],
  nix: { enabled: true },
  lockFileMaintenance: {
    // flake.nix does not pin revisions, so this is the only way the flake inputs
    // get updated. rust-toolchain.toml is resolved through rust-overlay, so a
    // nightly bump builds only after this PR has refreshed rust-overlay.
    enabled: true,
    // lockFileMaintenance has its own default schedule that overrides the
    // top-level one, so it needs the monthly cron explicitly.
    schedule: ["* 0-3 1 * *"],
  },
  packageRules: [
    {
      // Renovate classifies 0.47 -> 0.48 as "minor", but Cargo treats it as
      // breaking. Keep these out of the non-major group so each gets its own PR.
      matchManagers: ["cargo"],
      matchCurrentVersion: "<1.0.0",
      matchUpdateTypes: ["minor"],
      groupName: null,
    },
    {
      // Nightly bumps are classified as "patch" and would otherwise join the
      // non-major group. They can change clippy and rustfmt output, so keep
      // them in their own PR.
      matchManagers: ["rust-toolchain"],
      groupName: "rust toolchain",
      // rust-overlay picks up a new nightly some time after its release; without
      // this, the newest nightly may not be resolvable through the flake yet.
      minimumReleaseAge: "3 days",
    },
  ],
}
